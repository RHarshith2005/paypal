# ---------------------------------------------------------------------------
# Handshake — example environment. Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder; the app runs without any real credentials
# by falling back to clearly labelled SIMULATED components.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
# Allowed browser origin for the web app (CORS).
WEB_ORIGIN=http://localhost:5173
# Requests per minute per client address. Health checks are exempt.
RATE_LIMIT_MAX=300
# Optional shared secret. When set, every mutating /api call must send
# `x-handshake-write-token`. Leave empty for the local single-operator demo.
API_WRITE_TOKEN=

# --- Web -------------------------------------------------------------------
# Base URL the React app calls. Defaults to the local API when unset.
VITE_API_BASE_URL=http://localhost:8787
# Only when API_WRITE_TOKEN is set; must match it.
VITE_WRITE_TOKEN=

# --- Database --------------------------------------------------------------
# Optional. When set, the API uses this Postgres connection string and applies
# the Drizzle migrations on startup. Matches docker-compose.yml defaults.
# DATABASE_URL=postgres://handshake:handshake@localhost:5432/handshake
DATABASE_URL=
# Used only when DATABASE_URL is empty: embedded Postgres (PGlite) data dir.
PGLITE_DIR=.data/pglite

# docker compose Postgres credentials (local development only).
POSTGRES_PORT=5432
POSTGRES_USER=handshake
POSTGRES_PASSWORD=handshake
POSTGRES_DB=handshake

# --- AI (Anthropic) --------------------------------------------------------
# Without a key the agents run a deterministic scripted negotiator that is
# labelled SIMULATED in the transcript and in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# live: call the model and record each answer. replay: serve recorded answers and
# never touch the network (a cache miss fails visibly instead of going live).
LLM_MODE=live
LLM_CACHE_DIR=.data/llm-replay

# --- PayPal ----------------------------------------------------------------
# Without credentials the API uses the labelled mock PayPal adapter.
# The sandbox adapter talks only to the PayPal Sandbox base URL.
PAYPAL_MODE=mock          # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the listener subscription. Without it, deliveries are SKIPPED.
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=15000
# Retries after the first attempt; only 5xx, network and timeout failures retry.
PAYPAL_MAX_RETRIES=2
# Where the payer is returned after approving a sandbox order.
PAYPAL_RETURN_URL=http://localhost:5173/?paypal=return
PAYPAL_CANCEL_URL=http://localhost:5173/?paypal=cancel

# --- Merchant catalog ------------------------------------------------------
# Channel3 is NOT wired in this build: its documented request/response contract
# could not be verified, so no endpoint was invented. See docs/channel3.md.
# With the flag off (default) the merchant serves a 30-product fixture catalog
# that is labelled SIMULATED in the API and the UI.
CHANNEL3_ENABLED=false
CHANNEL3_API_KEY=
CHANNEL3_API_BASE=

# --- Demo seeding ----------------------------------------------------------
# Seeds Case A (valid purchase) and Case B (misconfigured agent) on first boot.
SEED_DEMO_DATA=true
